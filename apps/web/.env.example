# Optional. docker-compose.production.yml already pins the exact release it was published
# with; updating means downloading the newer file (see README → Updating). Set this only
# to run another release: it overrides the file's version on every later update.
# SEO_PLAYGROUND_VERSION=0.6.1

# Optional: expose the dashboard on a different local port.
# SEO_PLAYGROUND_PORT=3000

# Login is off by default and the dashboard spends your DataForSEO credit.
# Docker publishing and Node launches bind only this machine by default.
# Enable login or an authenticated reverse proxy before setting 0.0.0.0.
# For Node, export this variable in your shell before launching.
# SEO_PLAYGROUND_BIND=127.0.0.1

# Optional override for the Geo-grid worker's private internal secret.
# Leave blank to generate and persist one in the data volume.
# CRON_SECRET=

# Email + password login with accounts. Off by default so local installs keep working unchanged
# (docker-compose.nexo.yml turns it on). When true, the first visit creates the platform admin;
# public registration then closes and admins create client accounts in Dashboard → Usuários.
# Each client only sees the businesses linked to their account.
# AUTH_ENABLED=true
# Public URL of the dashboard. Set it when served behind a proxy; an https:// value also
# makes the session cookie Secure. Leave unset for plain http://localhost.
# BETTER_AUTH_URL=https://seo.example.com
# Optional. Generated and kept next to the database when blank.
# BETTER_AUTH_SECRET=

# ── Nexo (docker-compose.nexo.yml) ──────────────────────────────────────────
# Domain served with HTTPS by the "https" profile (Caddy). Its DNS must point to this server.
# NEXO_DOMAIN=painel.suaagencia.com.br
# Public address used in links sent by e-mail (monthly report, shared report links).
# NEXO_PUBLIC_URL=https://painel.suaagencia.com.br
# With login on (the default in docker-compose.nexo.yml), also set BETTER_AUTH_URL to the same address.
# BETTER_AUTH_URL=https://painel.suaagencia.com.br
# Time zone of the daily jobs (backup 03h, alerts and the monthly report).
# NEXO_TIME_ZONE=America/Sao_Paulo
# Daily database backup. Copy this folder to another machine or storage too.
# BACKUP_DIR=/data/backups
# BACKUP_KEEP_DAYS=14
# E-mail for alerts and reports (any SMTP: Gmail/Workspace, Amazon SES, Brevo, Resend SMTP...).
# Without SMTP_HOST and SMTP_FROM nothing is sent.
# SMTP_HOST=smtp.exemplo.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=Nexo <alertas@suaagencia.com.br>
# Optional: GitHub owner/repo whose releases the in-app update notice compares against.
# UPDATE_CHECK_REPO=
