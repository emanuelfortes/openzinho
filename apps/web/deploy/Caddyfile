# HTTPS in front of Nexo (docker-compose.nexo.yml, profile "https").
# Caddy gets and renews the certificate for NEXO_DOMAIN by itself.
{$NEXO_DOMAIN} {
	encode zstd gzip
	reverse_proxy app:3000
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}
